# ---------------------------------------------------------------
# Manifestei API — copie para .env e preencha.
# Gere segredos com:  openssl rand -base64 48
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# true quando atrás de load balancer/reverse proxy (para o IP real no rate limit)
TRUST_PROXY=false
LOG_LEVEL=info

DATABASE_URL=postgres://manifestei:manifestei@localhost:5432/manifestei
REDIS_URL=redis://localhost:6379

JWT_SECRET=troque-por-um-segredo-aleatorio-de-48-bytes-ou-mais
# Pepper do HMAC da âncora do aparelho (ANDROID_ID / UUID do Keychain). NUNCA troque
# depois de ir para produção (todos os aparelhos "virariam" novos). Guarde num cofre de segredos.
DEVICE_ANCHOR_PEPPER=troque-por-outro-segredo-aleatorio-de-48-bytes

# --- iOS / App Attest ---
APPLE_TEAM_ID=ABCDE12345
APPLE_BUNDLE_ID=br.org.manifestei.app
# true só em desenvolvimento (builds com entitlement "development")
APPLE_APP_ATTEST_ALLOW_DEVELOPMENT=true
APPLE_APP_ATTEST_ROOT_CA_PATH=./certs/Apple_App_Attestation_Root_CA.pem

# --- Android / Play Integrity ---
ANDROID_PACKAGE_NAME=br.org.manifestei.app
# JSON da service account com acesso à Play Integrity API (ou use GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_SERVICE_ACCOUNT_JSON=
PLAY_INTEGRITY_REQUIRE_STRONG=false
PLAY_INTEGRITY_REQUIRE_LICENSED=false
# SHA-256 do certificado de assinatura do app (Play Console > Assinatura do app). Aceita o formato
# do Console (AB:CD:...) ou base64url. Vários separados por vírgula.
PLAY_INTEGRITY_ALLOWED_CERT_DIGESTS=
PLAY_INTEGRITY_MAX_TOKEN_AGE_SECONDS=120
# Requerem opt-in no Play Console (Integridade do app > respostas opcionais)
PLAY_INTEGRITY_REJECT_UNKNOWN_CONTROLLING=true
PLAY_INTEGRITY_REJECT_HIGH_ACTIVITY=true

# --- Conta e consentimento ---
# Igual a extra.consentVersion do app (mobile/app.config.ts)
CONSENT_VERSION=2026-10
# Bloqueio de nova identidade após "apagar meus dados" (> duração máxima de um ato)
ACCOUNT_RECREATE_LOCK_HOURS=26

# --- Política de presença ---
PRESENCE_MAX_ACCURACY_M=50
PRESENCE_AREA_TOLERANCE_M=25
PRESENCE_MAX_FIX_AGE_SECONDS=120
PRESENCE_MAX_SPEED_MPS=70
# Padrão: o app lê sozinho a cada 15 min; presença confirmada com 2 leituras a 45 min de distância.
# Para confirmar no primeiro toque: PRESENCE_MIN_SAMPLES=1 e PRESENCE_MIN_DWELL_MINUTES=0.
PRESENCE_MIN_SAMPLES=2
PRESENCE_MIN_DWELL_MINUTES=45
PRESENCE_SAMPLE_INTERVAL_MINUTES=15
CHECKIN_OPENS_BEFORE_START_MINUTES=60
CHECKIN_CLOSES_AFTER_END_MINUTES=30
LOCATION_RETENTION_HOURS=72
