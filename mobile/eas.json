{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "APP_ATTEST_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_ATTEST_ENV": "production" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_ATTEST_ENV": "production" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" },
      "ios": {}
    }
  }
}
